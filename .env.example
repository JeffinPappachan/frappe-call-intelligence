# Application Configuration
APP_ENV=development
MOCK_MODE=true
HOST=0.0.0.0
PORT=8000

# Frappe Cloud CRM Configuration
FRAPPE_BASE_URL=https://crm-chm-lly.nvi.frappe.cloud
FRAPPE_API_KEY=your_frappe_api_key_here
FRAPPE_API_SECRET=your_frappe_api_secret_here

# AI & STT Provider Configuration
# Options: mock, groq, openai, gemini
AI_PROVIDER=mock
AI_API_KEY=your_ai_provider_api_key_here
STT_PROVIDER=mock
STT_API_KEY=your_stt_provider_api_key_here

# Storage / Audio Settings
AUDIO_STORAGE_DIR=./samples

# Security & Privacy Settings
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000"]
STORE_TRANSCRIPT_IN_CRM=truncated
ADMIN_API_TOKEN=

# Reliability & Idempotency Store
IDEMPOTENCY_BACKEND=memory
SQLITE_DB_PATH=idempotency.db
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_MAX_ITEMS=1000

# Observability & Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# Upstream Service Timeouts (Seconds)
REQUEST_TIMEOUT_SECONDS=60.0
STT_TIMEOUT_SECONDS=60.0
AI_TIMEOUT_SECONDS=45.0
FRAPPE_TIMEOUT_SECONDS=15.0
